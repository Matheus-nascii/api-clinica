        "description": "Cadastro público. Gera email novo para evitar 409 se já foi feito antes.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Aluno N3\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"senha\": \"{{senhaUsuario}}\"\n}",
