    {
      "name": "07 - POST consulta (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/consultas",
        "description": "Usa os IDs gerados e agenda para 30 dias depois. Salva consultaId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"dataHora\": \"{{dataConsulta}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Agenda 30 dias à frente, às 10h, na data local.",
              "const data = new Date();",
              "data.setDate(data.getDate()+30);",
              "const pad = n => String(n).padStart(2,'0');",
              "pm.collectionVariables.set('dataConsulta', `${data.getFullYear()}-${pad(data.getMonth()+1)}-${pad(data.getDate())}T10:00:00`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Consulta criada: 201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('consultaId', pm.response.json().id);"
            ]
          }
        }
      ],
      "response": []
    },
