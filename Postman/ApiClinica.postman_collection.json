    {
      "name": "05 - POST paciente (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/pacientes",
        "description": "Gera CPF de teste válido e email único. Salva pacienteId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana Souza N3\",\n  \"email\": \"{{pacienteEmail}}\",\n  \"telefone\": \"(47) 98888-7777\",\n  \"dataNasc\": \"2000-05-10\",\n  \"cpf\": \"{{pacienteCpf}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Gera CPF de teste numericamente válido e email único, para repetir a demonstração.",
              "const digits = Array.from({length:9}, () => Math.floor(Math.random()*10));",
              "if (digits.every(x=>x===digits[0])) digits[8] = (digits[8]+1)%10;",
              "function dv(ds, peso) { let n = (ds.reduce((s,d,i)=>s+d*(peso-i),0)*10)%11; return n===10?0:n; }",
              "const d1=dv(digits,10), d2=dv([...digits,d1],11);",
              "const cpf=[...digits,d1,d2].join('');",
              "pm.collectionVariables.set('pacienteCpf', `${cpf.slice(0,3)}.${cpf.slice(3,6)}.${cpf.slice(6,9)}-${cpf.slice(9)}`);",
              "pm.collectionVariables.set('pacienteEmail', `paciente.n3.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Paciente criado: 201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('pacienteId', pm.response.json().id);"
            ]
          }
        }
      ],
      "response": []
    },
