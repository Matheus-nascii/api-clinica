            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Gera um email diferente a cada apresentação para evitar conflito no SQLite.",
              "pm.collectionVariables.set('usuarioEmail', `aluno.n3.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Cadastro: 200 OK', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Cadastro sempre cria Usuario', () => pm.expect(data.role).to.eql('Usuario'));",
              "}"
