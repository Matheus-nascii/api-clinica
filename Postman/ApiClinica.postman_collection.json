  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Gera uma data 7 dias no futuro (formato yyyy-MM-dd) para as consultas",
          "const d = new Date(); d.setDate(d.getDate() + 7);",
          "const pad = n => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('dia', `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`);"
        ]
      }
    }
  ],
